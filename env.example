# Firebase (console.firebase.google.com → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Number customers send InstaPay / Vodafone Cash transfers to
VITE_TRANSFER_NUMBER=

# Store owner email(s), comma separated — shows the /admin orders page (use your Google account)
VITE_ADMIN_EMAILS=
